# Copy this file to .env.local and fill in your local database values.
# Example: POSTGRES_URL=postgres://username:password@localhost:5432/your_database
POSTGRES_URL=postgres://username:password@localhost:5432/your_database
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_POOL_SIZE=10
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# `openssl rand -base64 32`
AUTH_SECRET=
ALLOW_PUBLIC_STAFF_SIGNUP=false
INITIAL_ADMIN_NAME=Company Admin
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
AUTH_URL=http://localhost:3000/api/auth
